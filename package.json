{
  "name": "project-runner-server",
  "version": "3.0.0",
  "description": "Project runner server with tunnel support (Cloudflare + ngrok), real-time progress, Bun support",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "docker:build": "docker build -t project-runner:latest -f docker/Dockerfile .",
    "docker:up": "docker-compose -f docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker-compose.yml down",
    "docker:prod": "docker-compose -f docker/docker-compose.prod.yml up -d",
    "docker:prod:build": "docker build -t project-runner:latest -f docker/Dockerfile . && docker-compose -f docker/docker-compose.prod.yml up -d"
  },
  "keywords": ["project-runner", "tunnel", "cloudflare", "ngrok", "bun", "sse"],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "portfinder": "^1.0.32"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "optionalDependencies": {
    "bun": ">=1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
