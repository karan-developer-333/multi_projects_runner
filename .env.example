# Server Configuration
PORT=10000
NODE_ENV=production

# Projects Directory
PROJECTS_PATH=./projects

# Tunnel Configuration
TUNNEL_PROVIDER=cloudflare,ngrok
NGROK_AUTH_TOKEN=

# Timeouts (milliseconds)
STARTUP_TIMEOUT=30000
PORT_DETECT_TIMEOUT=20000
TUNNEL_TIMEOUT=30000

# Behavior
AUTO_RESTART_CRASHED=false
ENABLE_LOGGING=true
