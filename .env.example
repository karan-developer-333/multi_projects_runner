# Server Configuration
PORT=3000

# Projects Directory (relative to project root)
PROJECTS_DIR=./projects

# Tunnel Configuration
# Comma-separated list of tunnel providers in priority order
# Options: cloudflare, ngrok
# cloudflare - Free, no auth needed (uses trycloudflare.com)
# ngrok - Requires NGROK_AUTH_TOKEN
TUNNEL_PROVIDER=cloudflare,ngrok

# ngrok Authentication Token (optional, only if using ngrok)
# Get your token at: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=

# Timeouts (in milliseconds)
STARTUP_TIMEOUT=30000
PORT_DETECT_TIMEOUT=20000
TUNNEL_TIMEOUT=30000

# Behavior
AUTO_RESTART_CRASHED=false
